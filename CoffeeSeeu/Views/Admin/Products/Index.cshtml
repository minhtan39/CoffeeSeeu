@model List<CoffeeSeeu.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";

    // Lấy từ khóa tìm kiếm từ ViewBag (nếu có)
    var q = ViewBag.Query as string ?? "";
}

<!-- ============================================================================
     VIEW: Trang quản lý sản phẩm (Admin)
     - Hiển thị danh sách toàn bộ sản phẩm
     - Có chức năng tìm kiếm, thêm mới, sửa, xóa
============================================================================ -->

<h2 class="mb-3">Quản lý sản phẩm</h2>

<!-- Thanh tìm kiếm + nút thêm sản phẩm -->
<div class="mb-3 d-flex justify-content-between">

    <!-- Form tìm kiếm theo tên sản phẩm -->
    <form class="d-flex" method="get" asp-action="Products">
        <input name="q"
               value="@q"
               class="form-control me-2"
               placeholder="Tìm theo tên..." />
        <button class="btn btn-outline-secondary">Tìm</button>
    </form>

    <!-- Nút thêm sản phẩm mới -->
    <a class="btn btn-success" asp-action="CreateProduct">+ Thêm sản phẩm</a>
</div>

<!-- Hiển thị thông báo khi thêm/sửa/xóa thành công -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- Bảng danh sách sản phẩm -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>Ảnh</th>
            <th>Tên</th>
            <th>Giá</th>
            <th>Rating</th>
            <th>Mô tả</th>
            <th></th> <!-- Cột chứa nút thao tác -->
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <!-- Hiển thị ảnh sản phẩm -->
                <td style="width:100px;">
                    <img src="@p.ImageUrl"
                         alt="@p.Name"
                         style="width:80px;height:60px;object-fit:cover;border-radius:6px;" />
                </td>

                <!-- Tên sản phẩm -->
                <td>@p.Name</td>

                <!-- Giá sản phẩm (format VND) -->
                <td>@String.Format("{0:N0} VND", p.Price)</td>

                <!-- Điểm đánh giá -->
                <td>@p.Rating</td>

                <!-- Mô tả (giới hạn chiều rộng để nội dung không tràn bảng) -->
                <td style="max-width:360px;">@p.Description</td>

                <!-- Các nút thao tác: sửa và xóa -->
                <td style="white-space:nowrap;">

                    <!-- Nút sửa -->
                    <a class="btn btn-sm btn-primary me-1"
                       asp-action="EditProduct"
                       asp-route-id="@p.Id">
                        Sửa
                    </a>

                    <!-- Form xóa (POST + xác nhận) -->
                    <form asp-action="DeleteProduct"
                          asp-route-id="@p.Id"
                          method="post"
                          style="display:inline"
                          onsubmit="return confirm('Xác nhận xóa sản phẩm này?');">

                        <button type="submit"
                                class="btn btn-sm btn-danger">
                            Xóa
                        </button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>
