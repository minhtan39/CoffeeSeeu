@model CoffeeSeeu.Models.User
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 700px; margin: 0 auto;">
        <div class="text-center">
            <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle shadow"
                 style="width: 120px; height: 120px; object-fit: cover;">
            <h3 class="mt-3">@Model.FullName</h3>
            <p class="text-muted">@Model.Username</p>
        </div>

        <hr class="my-4">

        <div class="px-3">
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Số điện thoại:</strong> @Model.Phone</p>
            <p>
                <strong>Quyền hạn:</strong>
                <span class="badge bg-secondary">@Model.Role</span>
            </p>
        </div>

        <div class="text-center mt-4">
            <a asp-action="EditProfile" class="btn btn-primary px-4 rounded-pill">
                <i class="bi bi-pencil-square"></i> Chỉnh sửa thông tin
            </a>
        </div>
    </div>
</div>
