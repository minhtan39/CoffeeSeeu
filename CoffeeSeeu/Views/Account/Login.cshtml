@{
    ViewData["Title"] = "Đăng nhập";
}

<!-- ============================================================================
     VIEW: Đăng nhập tài khoản
     - Người dùng nhập username + password
     - Gửi POST → Account/Login
============================================================================ -->

<h2 class="mb-3">Đăng nhập</h2>

<!-- Form đăng nhập -->
<form asp-action="Login" method="post">

    <!-- Nhập tên đăng nhập -->
    <div class="form-group mb-3">
        <label>Tên đăng nhập:</label>
        <input name="username"
               class="form-control"
               placeholder="Nhập tên đăng nhập..." />
    </div>

    <!-- Nhập mật khẩu -->
    <div class="form-group mb-3">
        <label>Mật khẩu:</label>
        <input name="password"
               type="password"
               class="form-control"
               placeholder="Nhập mật khẩu..." />
    </div>

    <!-- Nút đăng nhập -->
    <button type="submit" class="btn btn-success">
        Đăng nhập
    </button>
</form>

<!-- Hiển thị lỗi đăng nhập -->
<p class="mt-2" style="color:red;">
    @ViewBag.Error
</p>

<!-- Điều hướng sang trang đăng ký -->
<p class="mt-3">
    Chưa có tài khoản?
    <a asp-action="Register">Đăng ký</a>
</p>
