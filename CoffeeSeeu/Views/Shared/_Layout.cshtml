@using CoffeeSeeu.Models
@inject IHttpContextAccessor HttpContextAccessor
@inject CoffeeSeeu.Data.ApplicationDbContext Db

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SeeU Coffee</title>

    <!-- Bootstrap + Icons (CDN) - load trước để custom CSS override sau -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <!-- File CSS custom của dự án (nên load sau Bootstrap) -->
    <link rel="stylesheet" href="~/css/style.css" />
</head>

<body>
    <!-- HEADER CHÍNH -->
    <header class="d-flex justify-content-between align-items-center px-4 py-2 border-bottom bg-light"
            style="position:relative; height:64px;">
        <div class="logo fs-3 fw-bold" style="color:#333;">SeeU</div>

        <nav>
            <ul class="nav">
                <li class="nav-item"><a asp-controller="Home" asp-action="Index" class="nav-link text-dark">Trang chủ</a></li>
                <li class="nav-item"><a asp-controller="Product" asp-action="Index" class="nav-link text-dark">Sản phẩm</a></li>
                <li class="nav-item"><a asp-controller="About" asp-action="Index" class="nav-link text-dark">Về chúng tôi</a></li>
                <li class="nav-item"><a href="#" class="nav-link text-dark">Liên hệ</a></li>
            </ul>
        </nav>

        <div class="auth-buttons d-flex align-items-center position-relative">
            @{
                // Lấy session username + role
                var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
                var role = HttpContextAccessor.HttpContext?.Session.GetString("Role");

                // Avatar mặc định
                string avatarPath = "/img/default-avatar.png";

                // Nếu đã đăng nhập -> lấy avatar từ DB (khuyến nghị: làm ở Controller)
                if (!string.IsNullOrEmpty(username))
                {
                    var user = Db.Users.FirstOrDefault(u => u.Username == username);
                    if (user != null && !string.IsNullOrEmpty(user.AvatarUrl))
                    {
                        avatarPath = user.AvatarUrl;
                    }
                }

                // Tính số lượng giỏ hàng từ session
                int cartCount = 0;
                try
                {
                    var cartJson = HttpContextAccessor.HttpContext?.Session.GetString("CartItems");
                    if (!string.IsNullOrEmpty(cartJson))
                    {
                        var _list = System.Text.Json.JsonSerializer.Deserialize<List<CartItem>>(cartJson);
                        cartCount = _list?.Sum(i => i.Quantity) ?? 0;
                    }
                }
                catch
                {
                    cartCount = 0;
                }
            }

            @if (!string.IsNullOrEmpty(username))
            {
                <div class="dropdown">
                    <a class="nav-link dropdown-toggle p-0 d-flex align-items-center text-dark"
                       href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="@avatarPath" alt="Avatar"
                             class="rounded-circle me-2"
                             style="width:40px;height:40px;object-fit:cover;border:2px solid #fff;">
                        <span style="font-weight:500;">@username</span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li><a class="dropdown-item" href="/Account/Profile">Thông tin cá nhân</a></li>
                        <li><a class="dropdown-item" href="/Account/Edit">Chỉnh sửa tài khoản</a></li>

                        @if (role == "Admin")
                        {
                            <li><a class="dropdown-item text-primary fw-semibold" href="/Admin/Index">Trang quản trị</a></li>
                            <li><hr class="dropdown-divider" /></li>
                        }

                        <li>
                            <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a href="/Account/Login" class="btn btn-outline-dark me-2">Đăng nhập</a>
                <a href="/Account/Register" class="btn btn-primary">Đăng ký</a>
            }

            <!-- Icon giỏ hàng -->
            <a asp-controller="Cart" asp-action="Index"
               class="sticker-cart ms-3 d-inline-flex align-items-center justify-content-center"
               title="Giỏ hàng">
                <i class="bi bi-cart3"></i>
                <span id="cartBadge" class="sticker-badge">@cartCount</span>
            </a>
        </div>
    </header>

    <!-- NỘI DUNG CHÍNH: render view con ở đây (chỉ 1 lần) -->
    <main class="container my-4">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="site-footer bg-light py-4 mt-auto">
        <div class="container footer-container">
            <div class="footer-newsletter mb-4">
                <h2>Đăng ký nhận tin</h2>
                <p>Nhận thông tin về sản phẩm mới, khuyến mãi đặc biệt từ SeeU.</p>
                <form class="newsletter-form d-flex">
                    <input type="email" placeholder="Email của bạn" class="form-control me-2" required />
                    <button type="submit" class="btn btn-primary">Đăng ký</button>
                </form>
            </div>

            <div class="footer-links d-flex justify-content-between flex-wrap mt-4">
                <div class="mb-3">
                    <h3>SeeU</h3>
                    <p>Mang đến hương vị cà phê tuyệt vời nhất.</p>
                </div>
                <div class="mb-3">
                    <h3>Sản phẩm</h3>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-dark">Cà phê hạt</a></li>
                        <li><a href="#" class="text-dark">Cà phê xay</a></li>
                        <li><a href="#" class="text-dark">Phụ kiện</a></li>
                    </ul>
                </div>
                <div class="mb-3">
                    <h3>Hỗ trợ</h3>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-dark">Hướng dẫn mua hàng</a></li>
                        <li><a href="#" class="text-dark">Chính sách đổi trả</a></li>
                        <li><a href="#" class="text-dark">Câu hỏi thường gặp</a></li>
                    </ul>
                </div>
                <div class="mb-3">
                    <h3>Liên hệ</h3>
                    <p>02 ngõ 13, Hải Thượng Lãn Ông</p>
                    <p>TP. Hà Tĩnh</p>
                    <p>seeucoffee.311@gmail.com</p>
                    <p>0818 115 578</p>
                </div>
            </div>

            <hr />
            <p class="text-center text-muted mb-0">&copy; 2025 SeeU Coffee. Tất cả quyền được bảo lưu.</p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scripts riêng của từng View -->
    @RenderSection("Scripts", required: false)
</body>
</html>
