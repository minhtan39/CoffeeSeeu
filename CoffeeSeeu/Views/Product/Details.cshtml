@model CoffeeSeeu.Models.Product

@{
    // Tiêu đề trang: nếu Model null thì hiển thị text mặc định
    ViewData["Title"] = Model?.Name ?? "Chi tiết sản phẩm";
}

<!-- ============================================================================
     FILE: Views/Product/Details.cshtml
     CHỨC NĂNG:
       - Hiển thị thông tin chi tiết một sản phẩm
       - Bao gồm: hình ảnh, mô tả, giá, nút thêm vào giỏ
       - Khi sản phẩm không tồn tại: hiển thị cảnh báo
============================================================================ -->

<link href="~/css/product.css" rel="stylesheet" />

<div class="container mt-4">

    <!-- Trường hợp sản phẩm bị null (không tìm thấy / đã xóa) -->
    @if (Model == null)
    {
        <div class="alert alert-warning">
            Sản phẩm không tồn tại hoặc đã bị xóa.
        </div>
    }
    else
    {
        <!-- Hiển thị nội dung chi tiết sản phẩm -->
        <div class="row">

            <!-- Cột ảnh sản phẩm -->
            <div class="col-md-6">
                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     class="img-fluid rounded" />
            </div>

            <!-- Cột thông tin sản phẩm -->
            <div class="col-md-6">

                <!-- Tên sản phẩm -->
                <h1 class="fw-bold">@Model.Name</h1>

                <!-- Mô tả sản phẩm -->
                <p class="text-muted">@Model.Description</p>

                <!-- Giá sản phẩm -->
                <p class="h4 text-danger fw-bold">
                    @Model.Price.ToString("N0") ₫
                </p>

                <!-- Nút thêm vào giỏ hàng -->
                <div class="mb-3">
                    <a href="/Cart/Add/@Model.Id" class="btn btn-dark">
                        Thêm vào giỏ
                    </a>
                </div>

            </div>
        </div>
    }
</div>
