@model IEnumerable<CoffeeSeeu.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var search = ViewData["SearchQuery"] as string;
}

<link href="~/css/product.css" rel="stylesheet" />

<!-- ============================================================================
     Views/Product/Index.cshtml
     MỤC ĐÍCH:
       - Hiển thị danh sách sản phẩm
       - Cung cấp thanh tìm kiếm có gợi ý (suggest)
       - Hiển thị grid sản phẩm, mỗi item có rating + nút thêm vào giỏ
     GHI CHÚ:
       - Controller gửi ViewData["CurrentFilter"] và ViewData["SearchQuery"]
       - JS phía client gọi API /Product/Suggest và /Product/RateProduct
============================================================================ -->

<div class="container mt-4">

    <!-- ======= Search: input + icon outside (kính lúp đặt bên ngoài ô) ======= -->
    <div class="row mb-4">
        <div class="col-md-8 offset-md-2">
            <!-- Form tìm kiếm: GET => Product/Index -->
            <form id="searchForm" asp-controller="Product" asp-action="Index" method="get"
                  class="search-wrapper mx-auto" style="max-width:800px;">
                <input type="text"
                       id="searchInput"
                       name="searchString"
                       class="form-control rounded-pill search-input px-4"
                       placeholder="Tìm kiếm sản phẩm..."
                       value="@ViewData["CurrentFilter"]"
                       autocomplete="off" />

                <!-- Nút kính lúp: nằm sát mép phải của input (không dùng offset âm) -->
                <button type="submit" class="search-btn-outside" aria-label="Tìm kiếm">
                    <i class="bi bi-search"></i>
                </button>

                <!-- Hộp gợi ý -->
                <div id="suggestBox" class="suggest-box" style="display:none;">
                    <ul id="suggestList" class="list-group mb-0"></ul>
                </div>
            </form>

        </div>
    </div>

    <!-- Nếu có từ khóa tìm kiếm nhưng không có kết quả -> cảnh báo người dùng -->
    @if (!string.IsNullOrEmpty(search) && (Model == null || !Model.Any()))
    {
        <div class="row mb-3">
            <div class="col-md-8 offset-md-2">
                <div class="alert alert-warning text-center mb-0">
                    Không tìm thấy sản phẩm cho "<strong>@Html.Encode(search)</strong>".
                    Bạn có thể thử từ khóa khác.
                </div>
            </div>
        </div>
    }

    <!-- ========================= GRID SẢN PHẨM ========================= -->
    <div class="row">
        @if (Model != null)
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card product-card h-100">
                        <!-- Ảnh sản phẩm -->
                        <img src="@item.ImageUrl" alt="@item.Name" class="card-img-top product-img" />

                        <div class="card-body d-flex flex-column">
                            <!-- Tên + mô tả + giá -->
                            <h5 class="card-title fw-bold">@item.Name</h5>
                            <p class="card-text text-muted">@item.Description</p>
                            <p class="fw-bold text-danger">@item.Price.ToString("N0") ₫</p>

                            <!-- ===== Rating (hiển thị & tương tác) =====
                                 - data-product-id: dùng để gửi POST lên /Product/RateProduct
                                 - data-current-rating: giữ trạng thái hiện tại (client-friendly)
                                 - Các <span class="star"> sẽ được JS xử lý mouseover/click
                            -->
                            <div class="rating mb-2" data-product-id="@item.Id" data-current-rating="@item.Rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="star @(i <= item.Rating ? "text-warning" : "text-secondary")"
                                          data-value="@i">★</span>
                                }
                            </div>

                            <!-- Nút thêm vào giỏ: hiện dùng link fallback (non-AJAX) -->
                            <a href="/Cart/Add/@item.Id" class="btn btn-dark mt-auto">Thêm vào giỏ</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

</div>

<!-- CSS nhỏ để đặt suggest box đúng vị trí -->
<style>
    .search-wrapper {
        position: relative;
    }

    .suggest-box {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 8px);
        z-index: 2000;
    }
</style>

@section Scripts {
    <script>
        (function(){
            // ====== Suggest (autocomplete) ======
            const searchForm = document.getElementById('searchForm');
            const input = document.getElementById('searchInput');
            const suggestBox = document.getElementById('suggestBox');
            const suggestList = document.getElementById('suggestList');

            let timer = null;
            input.setAttribute('autocomplete','off');

            // Debounce input để giảm số request
            input.addEventListener('input', (e) => {
                const q = e.target.value.trim();
                if (timer) clearTimeout(timer);
                if (!q) { suggestBox.style.display = 'none'; return; }

                timer = setTimeout(async () => {
                    try {
                        const res = await fetch(`/Product/Suggest?q=${encodeURIComponent(q)}`);
                        if (!res.ok) { suggestBox.style.display = 'none'; return; }
                        const items = await res.json();
                        renderSuggestions(items, q);
                    } catch (err) {
                        console.error('Suggest error', err);
                        suggestBox.style.display = 'none';
                    }
                }, 200); // debounce 200ms
            });

            // Helper: highlight đoạn khớp từ khóa
            function highlight(text, q) {
                const safe = q.replace(/[-\/\\^$*+?.()|[\]{}]/g,'\\$&');
                const re = new RegExp('(' + safe + ')','ig');
                return text.replace(re, '<strong>$1</strong>');
            }

            // Escape HTML tránh XSS
            function escapeHtml(str) {
                return String(str).replace(/[&<>"'`=\/]/g, function(s) {
                    return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;','/':'&#x2F;','`':'&#x60;','=':'&#x3D;'})[s];
                });
            }

            // Render suggestions vào suggestBox
            function renderSuggestions(items, q) {
                suggestList.innerHTML = '';
                if (!items || items.length === 0) { suggestBox.style.display = 'none'; return; }

                items.forEach(it => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item';
                    li.style.cursor = 'pointer';
                    li.innerHTML = highlight(escapeHtml(it.name), q);
                    li.addEventListener('click', () => {
                        // Click suggestion: điền input và submit form
                        input.value = it.name;
                        searchForm.submit(); // controller có thể redirect đến Details nếu exact match
                    });
                    suggestList.appendChild(li);
                });

                suggestBox.style.display = 'block';
            }

            // Click ngoài form -> ẩn suggest box
            document.addEventListener('click', (ev) => {
                if (!searchForm.contains(ev.target)) suggestBox.style.display = 'none';
            });
        })();
    </script>

    <!-- ===== Rating script =====
         - Lắng nghe hover/click trên các sao
         - Gửi POST tới /Product/RateProduct { productId, rating }
         - Cập nhật UI nếu server trả về success
    -->
    <script>
        document.querySelectorAll(".rating").forEach(ratingDiv => {
            const productId = ratingDiv.dataset.productId;
            const stars = ratingDiv.querySelectorAll(".star");
            let currentRating = parseInt(ratingDiv.dataset.currentRating) || 0;

            stars.forEach((star, index) => {
                // hover: tô màu tới vị trí hover
                star.addEventListener("mouseover", () => {
                    stars.forEach((s, i) => s.classList.toggle("text-warning", i <= index));
                });

                // mouseout: trả về trạng thái trước đó
                star.addEventListener("mouseout", () => {
                    stars.forEach((s, i) => s.classList.toggle("text-warning", i < currentRating));
                    stars.forEach((s, i) => s.classList.toggle("text-secondary", i >= currentRating));
                });

                // click: gửi rating lên server
                star.addEventListener("click", async () => {
                    const rating = index + 1;
                    try {
                        const response = await fetch(`/Product/RateProduct`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ productId, rating })
                        });
                        if (response.ok) {
                            const result = await response.json();
                            if (result.success) {
                                currentRating = rating;
                                ratingDiv.dataset.currentRating = rating;
                                stars.forEach((s, i) => {
                                    s.classList.toggle("text-warning", i < rating);
                                    s.classList.toggle("text-secondary", i >= rating);
                                });
                            }
                        } else {
                            alert('Không thể lưu đánh giá. Thử lại sau.');
                        }
                    } catch (err) {
                        console.error('Rate error', err);
                        alert('Lỗi khi gửi đánh giá. Thử lại sau.');
                    }
                });
            });
        });
    </script>
}
