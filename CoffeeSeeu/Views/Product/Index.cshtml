@model IEnumerable<CoffeeSeeu.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<link href="~/css/product.css" rel="stylesheet" />

<div class="container mt-4">
    <!-- Header chỉ còn giỏ hàng -->
    <div class="d-flex justify-content-end align-items-center mb-3 border-bottom pb-2">
        <a href="/Cart" class="btn btn-outline-dark">
            <i class="bi bi-cart"></i>
        </a>
    </div>

    <!-- Thanh tìm kiếm -->
    <div class="row mb-4">
        <div class="col-md-8 offset-md-2">
            <form asp-controller="Product" asp-action="Index" method="get" class="d-flex">
                <input type="text"
                       name="searchString"
                       class="form-control rounded-pill me-2"
                       placeholder="Tìm kiếm sản phẩm..."
                       value="@ViewData["CurrentFilter"]" />
                <button type="submit" class="btn btn-dark rounded-pill px-4">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Grid sản phẩm -->
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card product-card h-100">
                    <img src="@item.ImageUrl" alt="@item.Name" class="card-img-top product-img" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <p class="card-text text-muted">@item.Description</p>
                        <p class="fw-bold text-danger">@item.Price.ToString("N0") ₫</p>

                        <!-- Phần đánh giá sao -->
                        <div class="rating mb-2" data-product-id="@item.Id" data-current-rating="@item.Rating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="star @(i <= item.Rating ? "text-warning" : "text-secondary")" data-value="@i">★</span>
                            }
                        </div>

                        <a href="/Cart/Add/@item.Id" class="btn btn-dark mt-auto">Thêm vào giỏ</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .rating .star {
        cursor: pointer;
        font-size: 20px;
        transition: color 0.2s ease-in-out;
    }
</style>

@section Scripts {
    <script>
        document.querySelectorAll(".rating").forEach(ratingDiv => {
            const productId = ratingDiv.dataset.productId;
            const stars = ratingDiv.querySelectorAll(".star");
            let currentRating = parseInt(ratingDiv.dataset.currentRating);

            // Hover hiệu ứng sáng dần
            stars.forEach((star, index) => {
                star.addEventListener("mouseover", () => {
                    stars.forEach((s, i) => s.classList.toggle("text-warning", i <= index));
                });

                star.addEventListener("mouseout", () => {
                    stars.forEach((s, i) => s.classList.toggle("text-warning", i < currentRating));
                    stars.forEach((s, i) => s.classList.toggle("text-secondary", i >= currentRating));
                });

                // Khi click để đánh giá
                star.addEventListener("click", async () => {
                    const rating = index + 1;

                    const response = await fetch(`/Product/RateProduct`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ productId, rating })
                    });

                    if (response.ok) {
                        const result = await response.json();
                        if (result.success) {
                            currentRating = rating;
                            ratingDiv.dataset.currentRating = rating;
                            stars.forEach((s, i) => {
                                s.classList.toggle("text-warning", i < rating);
                                s.classList.toggle("text-secondary", i >= rating);
                            });
                        }
                    } else {
                        alert("Không thể lưu đánh giá, vui lòng thử lại!");
                    }
                });
            });
        });
    </script>
}
