@{
    ViewData["Title"] = "Về chúng tôi - SeeU Coffee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ============================================================================
     PHẦN GIỚI THIỆU CHUNG (Hero section)
     - Hiển thị tiêu đề, mô tả và hình ảnh đại diện của thương hiệu
============================================================================ -->
<section class="about-hero text-center py-5 bg-light">
    <div class="container">
        <h1 class="fw-bold mb-3" style="font-size: 2.5rem;">Về SeeU Coffee</h1>
        <p class="lead text-muted">
            SeeU Coffee – nơi mỗi tách cà phê là một câu chuyện, mỗi không gian là một trải nghiệm.
        </p>

        <!-- Ảnh giới thiệu thương hiệu -->
        <img src="~/img/logo.jpg"
             class="img-fluid rounded shadow mt-4"
             style="max-height: 400px; object-fit: cover;"
             alt="SeeU Coffee Store" />
    </div>
</section>

<!-- ============================================================================
     PHẦN GIỚI THIỆU THƯƠNG HIỆU
     - Nội dung về hành trình và nguồn gốc SeeU Coffee
============================================================================ -->
<section class="container my-5">
    <div class="row align-items-center">

        <!-- Ảnh minh họa -->
        <div class="col-md-6 mb-4 mb-md-0">
            <img src="~/img/shop.jpg" alt="Cà phê SeeU" class="img-fluid rounded-4 shadow-sm" />
        </div>

        <!-- Nội dung mô tả -->
        <div class="col-md-6">
            <h2 class="fw-semibold mb-3">Hành trình của SeeU Coffee</h2>
            <p>
                Được thành lập vào năm 2020, SeeU Coffee khởi nguồn từ niềm đam mê cà phê Việt Nam.
                Chúng tôi tin rằng hương vị cà phê không chỉ đơn thuần là thức uống mà còn là cầu nối cảm xúc,
                mang đến sự sẻ chia, kết nối và cảm hứng trong cuộc sống.
            </p>
            <p>
                Mỗi hạt cà phê được chọn lọc kỹ lưỡng từ các vùng nguyên liệu nổi tiếng như Đắk Lắk, Lâm Đồng,
                sau đó được rang xay thủ công để giữ trọn vị đậm đà tự nhiên.
            </p>
        </div>

    </div>
</section>

<!-- ============================================================================
     SỨ MỆNH & TẦM NHÌN
     - Trình bày mục tiêu và định hướng phát triển thương hiệu
============================================================================ -->
<section class="bg-light py-5">
    <div class="container text-center">
        <h2 class="fw-bold mb-4">Sứ mệnh & Tầm nhìn</h2>

        <div class="row g-4">

            <!-- SỨ MỆNH -->
            <div class="col-md-6">
                <div class="p-4 bg-white shadow-sm rounded-4 h-100">
                    <h4 class="fw-semibold mb-3">☕ Sứ mệnh</h4>
                    <p>
                        SeeU Coffee mong muốn mang đến cho khách hàng những trải nghiệm tuyệt vời nhất
                        với từng ly cà phê chất lượng, phục vụ trong không gian ấm áp và thân thiện.
                    </p>
                </div>
            </div>

            <!-- TẦM NHÌN -->
            <div class="col-md-6">
                <div class="p-4 bg-white shadow-sm rounded-4 h-100">
                    <h4 class="fw-semibold mb-3">🌿 Tầm nhìn</h4>
                    <p>
                        Trở thành thương hiệu cà phê hàng đầu Việt Nam,
                        nơi mọi người tìm đến không chỉ để thưởng thức cà phê mà còn để sẻ chia cảm xúc và sáng tạo.
                    </p>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- ============================================================================
     KHÔNG GIAN QUÁN (DỮ LIỆU LẤY ĐỘNG TỪ DATABASE)
     - Dùng ViewBag.SpaceImages (danh sách ảnh thuộc Album "Không gian quán")
============================================================================ -->
<section class="container my-5 text-center">
    <h2 class="fw-bold mb-4">Không gian quán</h2>
    <p class="text-muted mb-5">
        Một vài góc quen thuộc tại SeeU – nơi bạn có thể thư giãn và cảm nhận hương vị cuộc sống.
    </p>

    <div class="row g-4">
        @foreach (var img in ViewBag.SpaceImages ?? new List<dynamic>())
        {
            <div class="col-md-4">
                <img src="@img.ImagePath"
                     class="img-fluid rounded-4 shadow-sm"
                     alt="@img.Description" />
            </div>
        }
    </div>
</section>

<!-- ============================================================================
     ĐỘI NGŨ NHÂN VIÊN (DỮ LIỆU LẤY ĐỘNG TỪ DATABASE)
     - Dùng ViewBag.StaffImages (Album "Đội ngũ")
============================================================================ -->
<section class="bg-light py-5">
    <div class="container text-center">

        <h2 class="fw-bold mb-4">Đội ngũ của chúng tôi</h2>
        <p class="text-muted mb-5">
            Những người đứng sau mỗi ly cà phê thơm ngon.
        </p>

        <div class="row g-4 justify-content-center">
            @foreach (var staff in ViewBag.StaffImages ?? new List<dynamic>())
            {
                <div class="col-md-3 col-6">

                    <!-- Avatar nhân viên -->
                    <img src="@staff.ImagePath"
                         class="img-fluid rounded-circle mb-3 shadow-sm"
                         alt="@staff.Description" />

                    <!-- Tên nhân viên -->
                    <h5 class="fw-semibold">@staff.Description</h5>

                    <!-- Chức vụ -->
                    <p class="text-muted small">@staff.Role</p>
                </div>
            }
        </div>

    </div>
</section>

<!-- ============================================================================
     LỜI KẾT
     - Kêu gọi khách hàng khám phá menu
============================================================================ -->
<section class="text-center py-5">
    <h3 class="fw-semibold mb-3">Hãy ghé thăm SeeU Coffee ngay hôm nay ☕</h3>
    <a href="/Product" class="btn btn-primary px-4 py-2">Khám phá menu</a>
</section>
